{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/webfetch",
    "description": "Stealthy web fetcher that converts pages to clean, LLM-readable markdown",
    "version": "1.0.5",
    "icons": [
        {
            "src": "https://unpkg.com/@cynosure-mcp/webfetch@1.0.5/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/webfetch",
            "version": "1.0.5",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": []
        }
    ],
    "repository": {
        "url": "https://github.com/Cynosure-MCP-Collection/mcp-webfetch",
        "source": "github"
    }
}
