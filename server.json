{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/webfetch",
    "description": "Stealthy web fetcher that converts pages to clean, LLM-readable markdown",
    "version": "1.0.1",
    "icons": [
        {
            "src": "https://raw.githubusercontent.com/andreasjhagen/OpenAgent-MCPs/main/mcp-arachnifetch/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/webfetch",
            "version": "1.0.1",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": []
        }
    ],
    "repository": {
        "url": "https://github.com/andreasjhagen/OpenAgent-MCPs",
        "source": "github",
        "subfolder": "mcp-webfetch"
    }
}
